# Production Dockerfile for xtiandOS
# Multi-stage build for optimized image size

FROM node:22-alpine AS builder
WORKDIR /build

# Install build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev

# Copy monorepo root
COPY package*.json ./
COPY tsconfig.base.json ./

# Copy all workspaces
COPY apps ./apps
COPY packages ./packages

# Install dependencies
RUN npm ci

# Build all packages and apps
RUN npm run build
RUN npm run typecheck

# =====================================
# Production Runtime Image
# =====================================
FROM node:22-alpine

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ffmpeg ca-certificates tini

# Copy built artifacts from builder
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/apps ./apps
COPY --from=builder /build/packages ./packages
COPY --from=builder /build/package*.json ./
COPY --from=builder /build/tsconfig.base.json ./

# Prisma
COPY --from=builder /build/apps/api/prisma ./apps/api/prisma

# Environment
ENV NODE_ENV=production
ENV PORT=3101
ENV BIND=0.0.0.0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3101/health || exit 1

# Run as non-root
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodejs -u 1001
USER nodejs

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start API and web server
CMD ["sh", "-c", "npm run dev:api & npm run dev:web"]
