# xtiandOS API
PORT=3101
BIND=127.0.0.1

# 32+ char random secret used to encrypt provider API keys at rest (AES-256-GCM)
MASTER_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional: when set, every request must send header X-Auth-Token
AUTH_TOKEN=

# Absolute path to the Obsidian vault mjane uses as her brain
VAULT_PATH=/home/kali/Desktop/xtiandOS/vault

DATABASE_URL="file:./prisma/dev.db"
