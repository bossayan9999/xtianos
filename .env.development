# Development environment variables
NODE_ENV=development
PORT=3101
BIND=127.0.0.1

# SQLite for dev (fast, no setup)
DATABASE_URL="file:./prisma/dev.db"

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate test secret: openssl rand -hex 32
MASTER_SECRET=dev-secret-not-for-production-change-me-32-chars
AUTH_TOKEN=dev-token-12345

VAULT_PATH=./vault
WORKSPACE_DIR=./workspace

# Use free/demo APIs for development
OPENROUTER_API_KEY=sk-or-v1-demo
IMAGE_PROVIDER=openai
IMAGE_API_KEY=sk-demo

JAEGER_HOST=localhost
JAEGER_PORT=6831

LOG_LEVEL=debug
LOG_FORMAT=pretty
