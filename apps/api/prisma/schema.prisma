generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Provider {
  id        Int      @id @default(autoincrement())
  label     String
  kind      String
  baseUrl   String
  apiKeyEnc String?
  createdAt DateTime @default(now())
}

model Conversation {
  id        Int       @id @default(autoincrement())
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             Int             @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  toolCallsJson  String?
  qualityScore   Int?
  qualityFlags   String?
  grounded       Boolean         @default(false)
  qualityRevisions Int           @default(0)
  latencyMs      Int?
  tokensEstimated Int?
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       MessageFeedback?
}

model MessageFeedback {
  id        Int      @id @default(autoincrement())
  messageId Int      @unique
  vote      Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model RunRecord {
  id              Int      @id @default(autoincrement())
  runId           Int
  conversationId  Int
  prompt          String
  provider        String
  model           String
  mode            String   @default("chat")
  outputKind      String   @default("text")
  latencyMs       Int
  tokensEstimated Int?
  modelCalls      Int      @default(0)
  totalArtifacts  Int      @default(0)
  grounded        Boolean  @default(false)
  qualityScore    Int?
  qualityFlags    String?
  revisions       Int      @default(0)
  status          String   @default("done")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([conversationId])
}

model Project {
  id        Int         @id @default(autoincrement())
  name      String
  goal      String?
  status    String      @default("active")
  createdAt DateTime    @default(now())
  tasks     Task[]
}

model Task {
  id         Int      @id @default(autoincrement())
  projectId  Int?
  title      String
  status     String   @default("inbox")
  notes      String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Skill {
  id          Int      @id @default(autoincrement())
  dirName     String   @unique
  name        String
  description String
  enabled     Boolean  @default(false)
  source      String   @default("local")
  createdAt   DateTime @default(now())
}

model Artifact {
  id             Int      @id @default(autoincrement())
  conversationId Int?
  kind           String   @default("other")
  filename       String
  mime           String   @default("text/plain")
  contentBase64  String?
  textPreview    String?
  createdAt      DateTime @default(now())
}

model McpServer {
  id          Int     @id @default(autoincrement())
  name        String
  transport   String  @default("stdio")
  command     String
  args        String  @default("")
  envJson     String  @default("{}")
  url         String  @default("")
  headersJson String  @default("{}")
  enabled     Boolean @default(false)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String
  createdAt DateTime @default(now())
}

model MemoryChunk {
  id            Int      @id @default(autoincrement())
  source        String
  path          String?
  chunkIndex    Int      @default(0)
  content       String
  embeddingJson String
  createdAt     DateTime @default(now())

  @@index([source])
}

model Agent {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  displayName     String
  description     String
  personality     String   @default("")
  systemPromptAdd String   @default("")
  toolsAllowed    String   @default("*")
  providerId      Int?
  model           String?
  apiKeyEnc       String?
  color           String   @default("#57d9a3")
  icon            String   @default("🤖")
  orbitRadius     Int      @default(120)
  orbitAngle      Float    @default(0)
  status          String   @default("idle")
  isGeneral       Boolean  @default(false)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  passwordHash   String
  displayName    String          @default("admin")
  role           String          @default("admin")
  email          String?         @unique
  phone          String?
  totpSecret     String?
  totpEnabled    Boolean         @default(false)
  failedAttempts Int             @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  recoveryTokens RecoveryToken[]
}

model Session {
  id         String    @id
  userId     Int
  tokenHash  String    @unique
  createdIp  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Budget (personal finance) ────────────────────────────────────────────

model BudgetAccount {
  id            Int                 @id @default(autoincrement())
  name          String
  type          String              @default("checking") // checking | savings | credit | cash
  currency      String              @default("PHP")      // ISO code, e.g. PHP | USD | EUR
  balanceCents  Int                 @default(0)
  isClosed      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transactions  BudgetTransaction[]
}

// Singleton row (id = 1): base/display currency + optional conversion rates
model BudgetSetting {
  id           Int      @id
  baseCurrency String   @default("PHP")
  // JSON map { "USD": 56.0, "EUR": 62.0, ... } = how many base units one of that currency buys
  rates        Json
  updatedAt    DateTime @updatedAt
}

model BudgetCategory {
  id           Int                 @id @default(autoincrement())
  name         String
  type         String              @default("expense") // income | expense | savings | debt
  budgetCents  Int                 @default(0)          // monthly target (for expense/savings)
  color        String? 
  createdAt    DateTime            @default(now())
  transactions BudgetTransaction[]
}

model BudgetTransaction {
  id          Int             @id @default(autoincrement())
  accountId   Int
  categoryId  Int?
  amountCents Int              // positive = income, negative = expense
  date        DateTime        @default(now())
  description String
  payee       String?
  createdAt   DateTime        @default(now())
  account     BudgetAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
}
