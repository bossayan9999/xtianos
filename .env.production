# Production Environment Variables for xtiandOS

# ======== API Server ========
NODE_ENV=production
PORT=3101
BIND=0.0.0.0

# ======== Database (PostgreSQL) ========
# For production, migrate from SQLite to PostgreSQL
DATABASE_URL=postgresql://xtiandos:secure-password@postgres:5432/xtiandos
DATABASE_POOL_SIZE=20

# ======== Redis Cache ========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ======== Security ========
# Generate with: openssl rand -hex 32
MASTER_SECRET=your-256-bit-hex-secret-here-generate-with-openssl
# API authentication token (leave empty to disable)
AUTH_TOKEN=your-secure-api-token-here

# ======== Storage Paths ========
VAULT_PATH=/data/vault
WORKSPACE_DIR=/data/workspace

# ======== LLM Providers ========
# OpenRouter (recommended for cost)
OPENROUTER_API_KEY=sk-or-v1-...
# Or use individual providers:
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ======== Image Generation ========
IMAGE_PROVIDER=flux  # or openai, stable, nvidia
IMAGE_API_KEY=your-image-api-key
IMAGE_MODEL=flux-1-schnell
IMAGE_BASE_URL=https://api.replicate.com/v1

# ======== Email (SMTP for password recovery) ========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ======== Observability ========
JAEGER_HOST=jaeger
JAEGER_PORT=6831
PROMETHEUS_PORT=9090

# ======== Rate Limiting ========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ======== Docker ========
# Path to Docker socket (for agent Docker control)
DOCKER_HOST=unix:///var/run/docker.sock

# ======== Logging ========
LOG_LEVEL=info
LOG_FORMAT=json
